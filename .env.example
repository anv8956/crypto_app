# ==========================================
# Borderless — Environment Variables
# ==========================================

# Port and App URL
PORT=3000
APP_URL="http://localhost:3000"

# PostgreSQL Database (used with Prisma ORM in production)
DATABASE_URL="postgresql://borderless_user:borderless_pass@localhost:5432/borderless_db?schema=public"

# Redis Cache and Background Job Queue (BullMQ)
REDIS_URL="redis://localhost:6379"

# Security & Secrets (generate strong random secrets for production)
JWT_SECRET="replace_with_a_64_character_random_hex_string_for_jwt_tokens"
ENCRYPTION_KEY="replace_with_a_32_byte_aes_gcm_hex_key_for_pii_encryption"

# Sandbox Webhook Secrets
ONRAMP_WEBHOOK_SECRET="sandbox_onramp_secret_key_8921"
OFFRAMP_WEBHOOK_SECRET="sandbox_offramp_secret_key_1034"

# Blockchain Provider Configuration
# Supported: polygon, arbitrum, base, ethereum
POLYGON_RPC_URL="https://polygon-rpc.com"
ARBITRUM_RPC_URL="https://arb1.arbitrum.io/rpc"
BASE_RPC_URL="https://mainnet.base.org"

# Custody / Managed Key Provider (Fireblocks, Circle Programmable Wallets, or AWS KMS)
CUSTODY_PROVIDER="circle_sandbox" # or "fireblocks", "sandbox"
CIRCLE_API_KEY=""
FIREBLOCKS_API_KEY=""

# On-Ramp Provider Credentials (Razorpay India / Stripe / Plaid)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
STRIPE_SECRET_KEY=""

# Off-Ramp Payout Partner (Circle Mint / FedNow Gateway / Bridge.xyz)
BRIDGE_API_KEY=""
FEDNOW_GATEWAY_CLIENT_ID=""

# Sanctions & AML Screening Provider (ComplyAdvantage / Chainalysis / TRM Labs)
COMPLYADVANTAGE_API_KEY=""
TRM_LABS_API_KEY=""

# Optional Gemini API Key for compliance document parsing & OCR
GEMINI_API_KEY="MY_GEMINI_API_KEY"
